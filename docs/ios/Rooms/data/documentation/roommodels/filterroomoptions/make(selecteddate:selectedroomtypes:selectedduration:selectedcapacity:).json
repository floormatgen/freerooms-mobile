    {
      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "code" : "selectedRoomTypes",
              "type" : "codeVoice"
            },
            {
              "text" : " is collapsed onto the single-valued ",
              "type" : "text"
            },
            {
              "code" : "usage",
              "type" : "codeVoice"
            },
            {
              "text" : " field:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "1 selected: sends that type’s raw code (e.g. ",
                      "type" : "text"
                    },
                    {
                      "code" : "\"AUD\"",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ").",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "0 or >1 selected: sends ",
                      "type" : "text"
                    },
                    {
                      "code" : "nil",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " (the backend ignores it; multi-select",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "would need either backend support or a client-side post-filter).",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "code" : "CampusLocation",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " is intentionally NOT mapped here; it’s a client-side",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "post-filter applied via ",
                      "type" : "text"
                    },
                    {
                      "code" : "RoomInteractor.applyClientSideFilters(...)",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ".",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        }
      ],
