            },
            {
              "kind" : "identifier",
              "text" : "ImageCache"
            }
          ]
        }
      ],
      "kind" : "declarations"
    },
    {
      "content" : [
        {
          "anchor" : "Why-this-exists",
          "level" : 2,
          "text" : "Why this exists",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "code" : "UIImage(named:)",
              "type" : "codeVoice"
            },
            {
              "text" : " loads the full-resolution image and caches it in a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "system cache that doesn’t release easily. A 2000x1500 photo decompresses",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "into ~12 MB of bitmap memory. With ~270 bundled photos, scrolling through",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "lists can balloon memory quickly.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "code" : "ImageCache",
              "type" : "codeVoice"
            },
            {
              "text" : " solves this by:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Downsampling to the display size via ",
                      "type" : "text"
                    },
                    {
                      "code" : "preparingThumbnail(of:)",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " (~480 KB at ",
                      "type" : "text"
                    },
                    {
                      "code" : ".medium",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ")",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Storing the small thumbnail in an ",
                      "type" : "text"
                    },
                    {
                      "code" : "NSCache",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " with configurable limits",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "anchor" : "Architecture",
          "level" : 2,
          "text" : "Architecture",
          "type" : "heading"
        },
        {
          "code" : [
            "View layer (CachedImage)",
            "    |",
            "    +-- body: sync lookup via image(named:in:size:)",
            "              -> cache hit: instant return from NSCache",
            "              -> cache miss: UIImage(named:) + preparingThumbnail(of:)",
            "                 -> store in NSCache with byte cost",
            "                 -> return thumbnail"
          ],
          "syntax" : null,
          "type" : "codeListing"
        },
        {
          "anchor" : "Cache-key-format",
          "level" : 2,
          "text" : "Cache key format",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Keys are ",
              "type" : "text"
            },
            {
              "code" : "\"<imageName>-<pixelSize>\"",
              "type" : "codeVoice"
            },
            {
              "text" : " (e.g. ",
              "type" : "text"
            },
            {
              "code" : "\"K-J17-201-400\"",
              "type" : "codeVoice"
            },
            {
              "text" : "), so the same",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "image at different sizes gets separate cache entries without collisions.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Memory-budget",
          "level" : 2,
          "text" : "Memory budget",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Default limits via ",
              "type" : "text"
            },
            {
              "code" : "CacheConfig.default",
              "type" : "codeVoice"
            },
            {
              "text" : ": 50 items \/ 50 MB.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Approximate per-thumbnail costs (uncompressed bitmap: width × height × 4 bytes\/pixel,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "independent of source format — JPEG, HEIC, etc. decompress to the same bitmap size):",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : ".small",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " (200px):  ~120 KB",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : ".medium",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " (400px): ~480 KB",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : ".large",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " (1000px): ~3 MB",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "50 MB holds ~100 medium thumbnails — enough to scroll through the full",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "buildings list AND a building’s room list without evictions. ",
              "type" : "text"
            },
            {
              "code" : "NSCache",
              "type" : "codeVoice"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "also purges automatically under system memory pressure.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
